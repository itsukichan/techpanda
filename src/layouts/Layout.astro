---
export interface Props {
  title: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogUrl?: string;
  noindex?: boolean;
}
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";

import "../styles/global.css";

const { 
  title, 
  description = "Koki Miyakubo - フロントエンドエンジニアのポートフォリオサイト",
  ogTitle,
  ogDescription,
  ogImage = "/og-image.jpg",
  ogUrl,
  noindex = true
} = Astro.props;

const siteUrl = Astro.site || "https://techpanda.netlify.app";
const canonicalUrl = ogUrl || new URL(Astro.url.pathname, siteUrl).toString();
const metaTitle = ogTitle || title;
const metaDescription = ogDescription || description;
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content={metaDescription} />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(ogImage, siteUrl).toString()} />
    <meta property="og:site_name" content="Koki Miyakubo Portfolio" />
    <meta property="og:locale" content="ja_JP" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={new URL(ogImage, siteUrl).toString()} />
    
    <title>{title}</title>
    
    {noindex && (
      <>
        <meta name="robots" content="noindex, nofollow, noarchive" />
        <meta name="googlebot" content="noindex, nofollow, noarchive" />
        <meta name="bingbot" content="noindex, nofollow, noarchive" />
      </>
    )}
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css">
    <meta name="view-transition" content="same-origin" />
    <script is:inline>
      // ダークモードの初期化スクリプト
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') document.documentElement.classList.add('dark');
    </script>
    <script>
      // ページ遷移時にスクロール位置をリセット
      document.addEventListener('astro:page-load', () => {
        window.scrollTo(0, 0);
      });
    </script>
  </head>
  <body
    class="relative min-h-screen bg-background-light dark:bg-background-dark w-full overflow-x-hidden"
  >
    <div class="relative flex flex-col min-h-screen animate-fade-in">
      <Header />
      <main class="flex-1 mx-auto w-full max-w-2xl px-6 sm:px-8">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
