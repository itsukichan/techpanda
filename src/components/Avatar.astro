---
import { Image } from 'astro:assets'
import type { AvatarProps } from '@types/components';

export interface Props extends AvatarProps {}

const { imgSrc, alt = 'プロフィール画像' } = Astro.props;
---

<div
  class="w-32 h-32 rounded-full flex sm:ml-auto overflow-hidden border-4 border-background-light"
>
  <Image  src={imgSrc} loading="eager" alt={alt} />
</div>
